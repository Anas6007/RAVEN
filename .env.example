# انسخ هذا الملف إلى .env ثم ضع بياناتك الحقيقية
# لا تشارك ملف .env مع أي أحد ولا ترفعه إلى GitHub

API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=xxxx_xxybot

# معرفات المطورين الذين يمكنهم استخدام لوحة /dev (افصل بينها بفاصلة)
# يُضاف OWNER_ID تلقائيًا لهذه القائمة حتى لو لم يُكتب هنا.
OWNER_ID=your_telegram_user_id
DEV_IDS=

DEBUG=False

# عدد الـ workers المتزامنين لمعالجة تحديثات تيليجرام (ضغطات الأزرار/
# الرسائل الواردة). الافتراضي مناسب للتشغيل الصغير. عند حمل كبير (آلاف
# المستخدمين النشطين بنفس اللحظة) ارفعها إلى 32-64 حسب أنوية الخادم.
WORKERS=4

# اسم البوت الظاهر في رسالة السحب (النص القابل للضغط اللي يوديك لخاص البوت)
BOT_DISPLAY_NAME=اسم البوت هنا

# قناة "جميع السحوبات": يُنشر فيها تلقائيًا كل سحب يُنشئه أي مستخدم بالبوت.
# لازم تكون هذه المتغيرات الثلاثة مضبوطة والبوت مشرف في القناة، وإلا يتم تجاهل النشر فيها.
ALL_GIVEAWAYS_CHANNEL_ID=
ALL_GIVEAWAYS_CHANNEL_NAME=
ALL_GIVEAWAYS_CHANNEL_LINK=

# اتصال Redis (اختياري) — يُستخدم لتحديد معدّل الطلبات (rate limiting).
# إن تعذّر الاتصال، يسقط النظام تلقائيًا لكاش في الذاكرة بدون أي كسر لعمل البوت.
REDIS_URL=redis://localhost:6379/0

# قاعدة البيانات: SQLite افتراضيًا (مناسبة للتشغيل الصغير/التجربة فقط).
# ⚠️ عند عدد كبير من المستخدمين/القنوات/السحوبات المتزامنة، SQLite تصبح
# عنق الزجاجة الحقيقي (كتابة واحدة في نفس اللحظة فقط) بغض النظر عن أي
# تحسين آخر بالكود. للحجم الكبير استخدم Postgres:
#   pip install asyncpg
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# DATABASE_URL=

# إعدادات pool الاتصال (تُستخدم فقط مع Postgres/MySQL، تُتجاهل مع SQLite).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
